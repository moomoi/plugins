// Dev Toolbox: the conversions developers reach for, offline. A Tier A plugin with no network:
// type into Dev Toolbox (keyword "dev") and it offers every transform that makes sense for the
// text, each row copying its result. Base64, SHA-1 and SHA-256 are written out here because the
// plugin VM has no btoa or crypto.

const B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
const HEX = "0123456789abcdef"
const LOREM = ["lorem", "ipsum", "dolor", "sit", "amet", "consectetur", "adipiscing", "elit", "sed", "do", "eiusmod", "tempor", "incididunt", "ut", "labore", "et", "dolore", "magna", "aliqua", "enim", "ad", "minim", "veniam", "quis", "nostrud", "exercitation", "ullamco", "laboris", "nisi", "aliquip", "ex", "ea", "commodo", "consequat", "duis", "aute", "irure", "in", "reprehenderit", "voluptate", "velit", "esse", "cillum", "fugiat", "nulla", "pariatur"]

// ── Bytes ──

fn utf8(text) {
  let out = []
  for (let i = 0; i < text.length; i = i + 1) {
    let c = text.charCodeAt(i)
    if (c >= 0xd800 && c < 0xdc00 && i + 1 < text.length) {
      let d = text.charCodeAt(i + 1)
      if (d >= 0xdc00 && d < 0xe000) {
        c = 0x10000 + ((c - 0xd800) << 10) + (d - 0xdc00)
        i = i + 1
      }
    }
    if (c < 0x80) {
      out.push(c)
    } else if (c < 0x800) {
      out.push(0xc0 | (c >> 6), 0x80 | (c & 63))
    } else if (c < 0x10000) {
      out.push(0xe0 | (c >> 12), 0x80 | ((c >> 6) & 63), 0x80 | (c & 63))
    } else {
      out.push(0xf0 | (c >> 18), 0x80 | ((c >> 12) & 63), 0x80 | ((c >> 6) & 63), 0x80 | (c & 63))
    }
  }
  return out
}

// UTF-8 bytes to text, or null when they aren't valid UTF-8.
fn fromUtf8(bytes) {
  let out = ""
  let i = 0
  while (i < bytes.length) {
    let b = bytes[i]
    let n = b < 0x80 ? 0 : (b >> 5) === 6 ? 1 : (b >> 4) === 14 ? 2 : (b >> 3) === 30 ? 3 : -1
    if (n < 0 || i + n >= bytes.length) {
      return null
    }
    let c = n === 0 ? b : b & (0x3f >> n)
    for (let k = 1; k <= n; k = k + 1) {
      let x = bytes[i + k]
      if ((x >> 6) !== 2) {
        return null
      }
      c = (c << 6) | (x & 63)
    }
    if (c >= 0x10000) {
      c = c - 0x10000
      out = out + String.fromCharCode(0xd800 + (c >> 10), 0xdc00 + (c & 0x3ff))
    } else {
      out = out + String.fromCharCode(c)
    }
    i = i + n + 1
  }
  return out
}

fn hex(bytes) {
  let out = ""
  for (let i = 0; i < bytes.length; i = i + 1) {
    out = out + HEX[bytes[i] >> 4] + HEX[bytes[i] & 15]
  }
  return out
}

// ── Base64 ──

fn base64(bytes, url) {
  let out = ""
  for (let i = 0; i < bytes.length; i = i + 3) {
    let n = (bytes[i] << 16) | ((i + 1 < bytes.length ? bytes[i + 1] : 0) << 8) | (i + 2 < bytes.length ? bytes[i + 2] : 0)
    out = out + B64[(n >> 18) & 63] + B64[(n >> 12) & 63]
    out = out + (i + 1 < bytes.length ? B64[(n >> 6) & 63] : (url ? "" : "="))
    out = out + (i + 2 < bytes.length ? B64[n & 63] : (url ? "" : "="))
  }
  return url ? out.replaceAll("+", "-").replaceAll("/", "_") : out
}

// Base64 or base64url to bytes, or null when it isn't base64.
fn unbase64(text) {
  let s = text.trim().replaceAll("-", "+").replaceAll("_", "/")
  while (s.endsWith("=")) {
    s = s.slice(0, s.length - 1)
  }
  if (s.length === 0 || s.length % 4 === 1) {
    return null
  }
  let out = []
  let bits = 0
  let acc = 0
  for (let i = 0; i < s.length; i = i + 1) {
    let v = B64.indexOf(s[i])
    if (v < 0) {
      return null
    }
    acc = ((acc << 6) | v) & 0xffffff
    bits = bits + 6
    if (bits >= 8) {
      bits = bits - 8
      out.push((acc >> bits) & 255)
    }
  }
  return out
}

// ── Hashes ──

// SHA padding: the message as big-endian 32-bit words, padded to whole 64-byte blocks.
fn words(bytes) {
  let m = bytes.slice(0)
  let bitLen = bytes.length * 8
  m.push(0x80)
  while (m.length % 64 !== 56) {
    m.push(0)
  }
  let hi = Math.floor(bitLen / 4294967296)
  let lo = bitLen >>> 0
  m.push((hi >>> 24) & 255, (hi >>> 16) & 255, (hi >>> 8) & 255, hi & 255, (lo >>> 24) & 255, (lo >>> 16) & 255, (lo >>> 8) & 255, lo & 255)
  let w = []
  for (let i = 0; i < m.length; i = i + 4) {
    w.push(((m[i] << 24) | (m[i + 1] << 16) | (m[i + 2] << 8) | m[i + 3]) >>> 0)
  }
  return w
}

fn rotr(x, n) {
  return ((x >>> n) | (x << (32 - n))) >>> 0
}

fn rotl(x, n) {
  return ((x << n) | (x >>> (32 - n))) >>> 0
}

fn wordsHex(h) {
  let out = ""
  for (let i = 0; i < h.length; i = i + 1) {
    out = out + (h[i] >>> 0).toString(16).padStart(8, "0")
  }
  return out
}

const K256 = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
]

fn sha256(bytes) {
  let w = words(bytes)
  let h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
  for (let b = 0; b < w.length; b = b + 16) {
    let s = w.slice(b, b + 16)
    for (let i = 16; i < 64; i = i + 1) {
      let s0 = rotr(s[i - 15], 7) ^ rotr(s[i - 15], 18) ^ (s[i - 15] >>> 3)
      let s1 = rotr(s[i - 2], 17) ^ rotr(s[i - 2], 19) ^ (s[i - 2] >>> 10)
      s.push((s[i - 16] + s0 + s[i - 7] + s1) >>> 0)
    }
    let a = h[0]
    let bb = h[1]
    let c = h[2]
    let d = h[3]
    let e = h[4]
    let f = h[5]
    let g = h[6]
    let hh = h[7]
    for (let i = 0; i < 64; i = i + 1) {
      let t1 = (hh + (rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)) + ((e & f) ^ (~e & g)) + K256[i] + s[i]) >>> 0
      let t2 = ((rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)) + ((a & bb) ^ (a & c) ^ (bb & c))) >>> 0
      hh = g
      g = f
      f = e
      e = (d + t1) >>> 0
      d = c
      c = bb
      bb = a
      a = (t1 + t2) >>> 0
    }
    h = [(h[0] + a) >>> 0, (h[1] + bb) >>> 0, (h[2] + c) >>> 0, (h[3] + d) >>> 0, (h[4] + e) >>> 0, (h[5] + f) >>> 0, (h[6] + g) >>> 0, (h[7] + hh) >>> 0]
  }
  return wordsHex(h)
}

fn sha1(bytes) {
  let w = words(bytes)
  let h = [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0]
  for (let b = 0; b < w.length; b = b + 16) {
    let s = w.slice(b, b + 16)
    for (let i = 16; i < 80; i = i + 1) {
      s.push(rotl(s[i - 3] ^ s[i - 8] ^ s[i - 14] ^ s[i - 16], 1))
    }
    let a = h[0]
    let bb = h[1]
    let c = h[2]
    let d = h[3]
    let e = h[4]
    for (let i = 0; i < 80; i = i + 1) {
      let f = i < 20 ? (bb & c) | (~bb & d) : i < 40 ? bb ^ c ^ d : i < 60 ? (bb & c) | (bb & d) | (c & d) : bb ^ c ^ d
      let k = i < 20 ? 0x5a827999 : i < 40 ? 0x6ed9eba1 : i < 60 ? 0x8f1bbcdc : 0xca62c1d6
      let t = (rotl(a, 5) + f + e + k + s[i]) >>> 0
      e = d
      d = c
      c = rotl(bb, 30)
      bb = a
      a = t
    }
    h = [(h[0] + a) >>> 0, (h[1] + bb) >>> 0, (h[2] + c) >>> 0, (h[3] + d) >>> 0, (h[4] + e) >>> 0]
  }
  return wordsHex(h)
}

// ── JSON ──

fn pretty(value, indent) {
  let pad = "  ".repeat(indent)
  if (Array.isArray(value)) {
    if (value.length === 0) {
      return "[]"
    }
    return "[\n" + value.map((v) => pad + "  " + pretty(v, indent + 1)).join(",\n") + "\n" + pad + "]"
  }
  if (value !== null && typeof value === "object") {
    let keys = Object.keys(value)
    if (keys.length === 0) {
      return "{}"
    }
    return "{\n" + keys.map((k) => pad + "  " + JSON.stringify(k) + ": " + pretty(value[k], indent + 1)).join(",\n") + "\n" + pad + "}"
  }
  return JSON.stringify(value)
}

fn parseJson(text) {
  let t = text.trim()
  if (!(t.startsWith("{") || t.startsWith("["))) {
    return null
  }
  try {
    return { value: JSON.parse(t) }
  } catch (e) {
    return null
  }
}

// ── Colors ──

fn clamp(n, lo, hi) {
  return n < lo ? lo : n > hi ? hi : n
}

fn toHex2(n) {
  return Math.round(clamp(n, 0, 255)).toString(16).padStart(2, "0")
}

fn rgbToHsl(r, g, b) {
  let rr = r / 255
  let gg = g / 255
  let bb = b / 255
  let max = Math.max(rr, gg, bb)
  let min = Math.min(rr, gg, bb)
  let l = (max + min) / 2
  let h = 0
  let s = 0
  if (max !== min) {
    let d = max - min
    s = l > 0.5 ? d / (2 - max - min) : d / (max + min)
    h = max === rr ? (gg - bb) / d + (gg < bb ? 6 : 0) : max === gg ? (bb - rr) / d + 2 : (rr - gg) / d + 4
    h = h * 60
  }
  return [Math.round(h), Math.round(s * 100), Math.round(l * 100)]
}

fn hslToRgb(h, s, l) {
  let ss = s / 100
  let ll = l / 100
  let k = (n) => (n + h / 30) % 12
  let a = ss * Math.min(ll, 1 - ll)
  let f = (n) => ll - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1)))
  return [Math.round(f(0) * 255), Math.round(f(8) * 255), Math.round(f(4) * 255)]
}

// "#ff5a8a", "ff5a8a", "#f5a", "rgb(255, 90, 138)" or "hsl(342, 100%, 68%)" -> [r, g, b], or null.
fn parseColor(text) {
  let t = text.trim().toLowerCase()
  let h = t.startsWith("#") ? t.slice(1) : t
  let isHex = (h.length === 3 || h.length === 6) && h.split("").every((c) => HEX.indexOf(c) >= 0)
  if (isHex && (t.startsWith("#") || h.length === 6)) {
    if (h.length === 3) {
      h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2]
    }
    return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)]
  }
  let open = t.indexOf("(")
  if (open > 0 && t.endsWith(")")) {
    let kind = t.slice(0, open).trim()
    let parts = t.slice(open + 1, t.length - 1).replaceAll("%", "").split(",").map((p) => parseFloat(p.trim()))
    if (parts.length >= 3 && !parts.slice(0, 3).some((p) => isNaN(p))) {
      if (kind === "rgb" || kind === "rgba") {
        return [clamp(parts[0], 0, 255), clamp(parts[1], 0, 255), clamp(parts[2], 0, 255)]
      }
      if (kind === "hsl" || kind === "hsla") {
        return hslToRgb(parts[0], parts[1], parts[2])
      }
    }
  }
  return null
}

// ── Time ──

fn isDigits(t) {
  return t.length > 0 && t.split("").every((c) => "0123456789".indexOf(c) >= 0)
}

fn ago(ms) {
  let s = Math.round((Date.now() - ms) / 1000)
  let future = s < 0
  let a = Math.abs(s)
  let text = a < 60 ? a + " seconds" : a < 3600 ? Math.round(a / 60) + " minutes" : a < 86400 ? Math.round(a / 3600) + " hours" : Math.round(a / 86400) + " days"
  return future ? "in " + text : text + " ago"
}

// ── Lorem ──

fn lorem(sentences) {
  let out = []
  let seed = 7
  for (let s = 0; s < sentences; s = s + 1) {
    let n = 8 + (seed % 7)
    let words = []
    for (let i = 0; i < n; i = i + 1) {
      seed = (seed * 31 + 17) % 9973
      words.push(LOREM[seed % LOREM.length])
    }
    let sentence = words.join(" ")
    out.push(sentence[0].toUpperCase() + sentence.slice(1) + ".")
  }
  return out.join(" ")
}

// ── Rows ──

fn row(title, subtitle, copy, icon) {
  return { title: title, subtitle: subtitle, icon: "symbol:" + icon, action: { copy: copy, hud: "Copied " + subtitle.toLowerCase() } }
}

fn short(text) {
  let one = text.replaceAll("\n", " ")
  return one.length > 90 ? one.slice(0, 89) + "…" : one
}

fn jwtRows(t) {
  let parts = t.split(".")
  if (parts.length !== 3 || parts[0].length < 4) {
    return []
  }
  let head = unbase64(parts[0])
  let body = unbase64(parts[1])
  if (head === null || body === null) {
    return []
  }
  let h = parseJson(fromUtf8(head) || "")
  let p = parseJson(fromUtf8(body) || "")
  if (h === null || p === null) {
    return []
  }
  let rows = [
    row(short(JSON.stringify(p.value)), "JWT payload", pretty(p.value, 0), "key"),
    row(short(JSON.stringify(h.value)), "JWT header", pretty(h.value, 0), "key")
  ]
  if (typeof p.value.exp === "number") {
    let ms = p.value.exp * 1000
    rows.push(row(new Date(ms).toISOString(), (ms < Date.now() ? "Expired " : "Expires ") + ago(ms), new Date(ms).toISOString(), "clock"))
  }
  return rows
}

fn timeRows(t) {
  let rows = []
  if (t === "now") {
    let now = Date.now()
    return [row("" + Math.floor(now / 1000), "Unix seconds", "" + Math.floor(now / 1000), "clock"), row("" + now, "Unix milliseconds", "" + now, "clock"), row(new Date(now).toISOString(), "ISO 8601", new Date(now).toISOString(), "calendar")]
  }
  if (isDigits(t) && (t.length === 10 || t.length === 13)) {
    let ms = t.length === 10 ? parseInt(t) * 1000 : parseInt(t)
    let iso = new Date(ms).toISOString()
    rows.push(row(iso, "ISO 8601 · " + ago(ms), iso, "calendar"))
    return rows
  }
  if (t.length >= 10 && "0123456789".indexOf(t[0]) >= 0 && t[4] === "-") {
    let ms = Date.parse(t)
    if (!isNaN(ms)) {
      rows.push(row("" + Math.floor(ms / 1000), "Unix seconds · " + ago(ms), "" + Math.floor(ms / 1000), "clock"))
      rows.push(row("" + ms, "Unix milliseconds", "" + ms, "clock"))
    }
  }
  return rows
}

fn colorRows(t) {
  let c = parseColor(t)
  if (c === null) {
    return []
  }
  let hexText = "#" + toHex2(c[0]) + toHex2(c[1]) + toHex2(c[2])
  let hsl = rgbToHsl(c[0], c[1], c[2])
  let rgbText = "rgb(" + Math.round(c[0]) + ", " + Math.round(c[1]) + ", " + Math.round(c[2]) + ")"
  let hslText = "hsl(" + hsl[0] + ", " + hsl[1] + "%, " + hsl[2] + "%)"
  return [row(hexText, "Hex color", hexText, "paintpalette"), row(rgbText, "RGB color", rgbText, "paintpalette"), row(hslText, "HSL color", hslText, "paintpalette")]
}

fn textRows(t) {
  let rows = []
  let bytes = utf8(t)
  let decoded = unbase64(t)
  let decodedText = decoded !== null && t.length >= 4 ? fromUtf8(decoded) : null
  if (decodedText !== null && decodedText.length > 0 && decodedText.split("").every((ch) => ch.charCodeAt(0) >= 9)) {
    rows.push(row(short(decodedText), "Base64 decoded", decodedText, "arrow.down.doc"))
  }
  if (t.indexOf("%") >= 0) {
    try {
      let u = decodeURIComponent(t)
      if (u !== t) {
        rows.push(row(short(u), "URL decoded", u, "link"))
      }
    } catch (e) {}
  }
  rows.push(row(short(base64(bytes, false)), "Base64", base64(bytes, false), "arrow.up.doc"))
  let enc = encodeURIComponent(t)
  if (enc !== t) {
    rows.push(row(short(enc), "URL encoded", enc, "link"))
  }
  rows.push(row(sha256(bytes), "SHA-256", sha256(bytes), "number"))
  rows.push(row(sha1(bytes), "SHA-1", sha1(bytes), "number"))
  let words = t.trim().split(" ").filter((w) => w !== "").length
  rows.push(row(t.length + " characters · " + words + " words · " + bytes.length + " bytes", "Text stats", "" + t.length, "textformat.size"))
  return rows
}

fn toolbox(text) {
  let t = text.trim()
  if (t === "") {
    return [
      { title: "Paste or type something", subtitle: "Base64, URLs, JWTs, JSON, timestamps, colors, hashes" },
      row("" + Math.floor(Date.now() / 1000), "Unix seconds now", "" + Math.floor(Date.now() / 1000), "clock"),
      row(lorem(2), "Lorem ipsum", lorem(2), "text.alignleft")
    ]
  }
  let json = parseJson(t)
  if (json !== null) {
    return [row(short(JSON.stringify(json.value)), "Minified JSON", JSON.stringify(json.value), "curlybraces"), row(short(pretty(json.value, 0)), "Pretty JSON", pretty(json.value, 0), "curlybraces")]
  }
  if (t.startsWith("lorem")) {
    let n = parseInt(t.slice(5).trim())
    let count = isNaN(n) ? 3 : clamp(n, 1, 20)
    return [row(short(lorem(count)), count + " sentences of lorem ipsum", lorem(count), "text.alignleft")]
  }
  return jwtRows(t).concat(timeRows(t)).concat(colorRows(t)).concat(t.length > 4000 ? [] : textRows(t))
}

fn list(command, query) {
  if (command === "lorem") {
    let n = parseInt(query.trim())
    let count = isNaN(n) ? 3 : clamp(n, 1, 20)
    return [row(short(lorem(count)), count + " sentences", lorem(count), "text.alignleft"), row(short(lorem(count * 4)), count * 4 + " sentences", lorem(count * 4), "text.alignleft")]
  }
  if (command === "time") {
    let rows = timeRows(query.trim() === "" ? "now" : query.trim())
    return rows.length > 0 ? rows : [{ title: "Type a Unix timestamp or a date", subtitle: "1767225600, 2026-01-01, now" }]
  }
  return toolbox(query)
}

register({
  manifest: () => ({
    id: "devtools",
    title: "Dev Toolbox",
    icon: "symbol:wrench.and.screwdriver",
    commands: [
      { name: "toolbox", title: "Dev Toolbox", subtitle: "Base64, URL, JWT, JSON, hashes, colors, timestamps", mode: "list", keyword: "dev", icon: "symbol:wrench.and.screwdriver" },
      { name: "time", title: "Convert Timestamp", subtitle: "Unix ↔ ISO 8601", mode: "list", keyword: "ts", icon: "symbol:clock" },
      { name: "lorem", title: "Generate Lorem Ipsum", subtitle: "Placeholder text", mode: "list", keyword: "lorem", icon: "symbol:text.alignleft" }
    ]
  }),
  run: (command) => null,
  list: list
})
